# Copy to .env.local and paste real keys. Free tier at console.groq.com/keys
# Without these the voice layer still runs — it just drops to the keyword tier
# and can only answer the fixed commands.

# conversation + intent
VITE_GROQ_KEY=gsk_your_key_here

# goal price estimation only, kept on a separate key so estimation traffic
# can be rotated or rate-limited without touching the voice loop
VITE_GROQ_ESTIMATE_KEY=gsk_your_estimate_key_here
